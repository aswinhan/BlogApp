@Host = https://localhost:7000
@Email = secure.user@example.com
@Password = P@ssword123!

### 1. Register a New User
POST {{Host}}/users/register
Content-Type: application/json

{
  "firstName": "Aswin",
  "lastName": "Rajan",
  "email": "{{Email}}",
  "password": "{{Password}}"
}

### 2. Log In (Simulating Frontend)
# @name login
POST {{Host}}/users/login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

### 3. Get User Profile (Protected Route)
# This now uses the token from the request above automatically!
GET {{Host}}/weatherforecast
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### 4. Refresh Token (Rotate Session)
POST {{Host}}/users/refresh
Content-Type: application/json
# Cookie is sent automatically by the HTTP Client

### 5. Forgot Password
POST {{Host}}/users/forgot-password
Content-Type: application/json

{
  "email": "{{Email}}"
}

### 6. Hack Attempt (Reset Password)
POST {{Host}}/users/reset-password
Content-Type: application/json

{
  "email": "{{Email}}",
  "token": "<PASTE_TOKEN_FROM_CONSOLE_LOG>",
  "newPassword": "NewP@ssword999!"
}

### 7. Create Article (Blog Module)
# Uses the same token from step 2 automatically
POST {{Host}}/articles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Why Modular Monoliths Rock",
  "content": "Microservices are complex. Modules are simple.",
  "summary": "A deep dive into architecture.",
  "tags": ["architecture", "dotnet", "csharp"]
}

### 8. Get Article by ID
# @name getArticle
GET {{Host}}/articles/ed5a362f-6117-43d5-8f66-f2b28e4bd062
Accept: application/json

### 9. Publish Article
# @name publishArticle
PUT {{Host}}/articles/ed5a362f-6117-43d5-8f66-f2b28e4bd062/publish
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

### 10. Verify It Is Published
GET {{Host}}/articles/ed5a362f-6117-43d5-8f66-f2b28e4bd062
Accept: application/json

### 11. Add Comment
# @name addComment
POST {{Host}}/articles/ed5a362f-6117-43d5-8f66-f2b28e4bd062/comments
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "content": "This architecture is amazing! Great post."
}